# Copy sang .env rồi điền giá trị thật. .env đã nằm trong .gitignore, đừng commit.
# Chạy: node --env-file=.env scripts/smoke/login.mjs

# Token tài khoản người dùng (KHÔNG phải bot token, không có prefix "Bot ").
# Lấy ở discord.com: F12 > Network > một request /api/v9/... > header `authorization`.
DISCORD_TOKEN=

# Chỉ cần cho examples/PasswordLogin.js. Bỏ trống nếu chỉ dùng token.
# Đăng nhập bằng mật khẩu rủi ro hơn: Discord soi kỹ và hay bắt captcha.
DISCORD_EMAIL=
DISCORD_PASSWORD=
DISCORD_MFA_SECRET=

# Bắt buộc cho scripts/smoke/write.mjs, script này SỬA hồ sơ thật (rồi trả lại
# ngay trong phiên). Thiếu biến này thì nó từ chối chạy.
SMOKE_ALLOW_WRITE=

# Chỉ cần cho scripts/smoke/voice.mjs. Id một voice channel bạn có quyền Connect
# và Speak. LƯU Ý: vào voice channel là cả server nhìn thấy, chọn kênh vắng.
SMOKE_VOICE_CHANNEL_ID=

# Chỉ cần cho scripts/smoke/interaction.mjs. Dán link kênh từ Discord cũng được:
# https://discord.com/channels/<guild>/<channel>. Kênh phải có bot và bạn có
# quyền Use Application Commands. LƯU Ý: chạy lệnh là cả server thấy và KHÔNG
# xoá được — chọn kênh bot-spam.
SMOKE_INTERACTION_CHANNEL_ID=

# Tuỳ chọn: ghim đúng một lệnh thay vì để script tự chọn lệnh vô hại.
SMOKE_INTERACTION_COMMAND=
